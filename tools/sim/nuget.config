<?xml version="1.0" encoding="utf-8"?>
<!--
  The simulation projects deliberately have ZERO NuGet dependencies, so no
  package source is needed. Clearing the sources keeps restore fully offline
  and makes builds reproducible on a machine with no network access.

  If you later add a real dependency (e.g. a test framework), add nuget.org
  back here.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
