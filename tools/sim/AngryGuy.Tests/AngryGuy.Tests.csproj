<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately a plain console app with a hand-rolled assert helper instead of
    xUnit/NUnit: zero NuGet dependencies means `dotnet run` works on any machine
    with the SDK, offline, with no restore step. Swap in a real test framework
    when the suite outgrows this.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Targets whatever .NET version the installed SDK ships, so this builds with
      zero downloads on a .NET 8 machine and a .NET 10 machine alike. Hardcoding
      net8.0 fails with NU1100 on an SDK that has no .NET 8 reference packs.
    -->
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>AngryGuy.Tests</RootNamespace>
    <AssemblyName>AngryGuy.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AngryGuy.Core.Net/AngryGuy.Core.Net.csproj" />
  </ItemGroup>

</Project>
