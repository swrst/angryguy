<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plays the game in a terminal against the same simulation Unity will run.
    Useful for tuning AI numbers without waiting on an editor, and for watching
    the NPCs live their lives with no player interference at all.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Targets whatever .NET version the installed SDK ships, so this builds with
      zero downloads on a .NET 8 machine and a .NET 10 machine alike. Hardcoding
      net8.0 fails with NU1100 on an SDK that has no .NET 8 reference packs.
    -->
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>AngryGuy.Headless</RootNamespace>
    <AssemblyName>AngryGuy.Headless</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AngryGuy.Core.Net/AngryGuy.Core.Net.csproj" />
  </ItemGroup>

</Project>
